<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".CarbonFootprintFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.LargeComponent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/scan_toolbar"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#2E7D32"
            android:paddingTop="30dp">

            <ImageButton
                android:id="@+id/btn_back_map"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go Back"
                android:src="?attr/homeAsUpIndicator"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:text="Carbon Footprint Calculator"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Carbon Footprint Saved"
        android:textColor="#2E7D32"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout" />

    <TextView
        android:id="@+id/textViewGrossTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Gross Total Saved: 0 kg CO₂e"
        android:textColor="#555555"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTitle" />

    <EditText
        android:id="@+id/editTextPlastic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:background="@android:drawable/edit_text"
        android:hint="Plastic (kg)"
        android:inputType="numberDecimal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewGrossTotal" />

    <EditText
        android:id="@+id/editTextPaper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:drawable/edit_text"
        android:hint="Paper (kg)"
        android:inputType="numberDecimal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="@+id/editTextPlastic"
        app:layout_constraintStart_toStartOf="@+id/editTextPlastic"
        app:layout_constraintTop_toBottomOf="@+id/editTextPlastic" />

    <EditText
        android:id="@+id/editTextAluminium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:drawable/edit_text"
        android:hint="Aluminium (kg)"
        android:inputType="numberDecimal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="@+id/editTextPlastic"
        app:layout_constraintStart_toStartOf="@+id/editTextPlastic"
        app:layout_constraintTop_toBottomOf="@+id/editTextPaper" />

    <EditText
        android:id="@+id/editTextGlass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:drawable/edit_text"
        android:hint="Glass (kg)"
        android:inputType="numberDecimal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="@+id/editTextPlastic"
        app:layout_constraintStart_toStartOf="@+id/editTextPlastic"
        app:layout_constraintTop_toBottomOf="@+id/editTextAluminium" />

    <EditText
        android:id="@+id/editTextOrganic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:drawable/edit_text"
        android:hint="Organic Food Waste (kg)"
        android:inputType="numberDecimal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="@+id/editTextPlastic"
        app:layout_constraintStart_toStartOf="@+id/editTextPlastic"
        app:layout_constraintTop_toBottomOf="@+id/editTextGlass" />

    <Button
        android:id="@+id/buttonCalculate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="#2E7D32"
        android:paddingVertical="12dp"
        android:text="Calculate Impact"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/editTextPlastic"
        app:layout_constraintStart_toStartOf="@+id/editTextPlastic"
        app:layout_constraintTop_toBottomOf="@+id/editTextOrganic" />


    <ImageView
        android:id="@+id/imageViewFootprint"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="80dp"
        android:alpha="0.1"
        android:contentDescription="Footprint Icon"
        android:src="@drawable/ic_green_footprint"
        android:visibility="gone"

        app:layout_constraintVertical_chainStyle="packed"

        app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@+id/textViewResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:text="Current Saved: 0 kg CO₂e"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@+id/imageViewFootprint"
        app:layout_constraintBottom_toTopOf="@+id/btn_ok"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/btn_ok"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:backgroundTint="#2E7D32"
        android:text="OK"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@+id/textViewResult"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupInputs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="editTextPlastic,editTextPaper,editTextAluminium,editTextGlass,editTextOrganic,buttonCalculate" />

</androidx.constraintlayout.widget.ConstraintLayout>