<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MapFragment">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:padding="8dp"
        android:background="#80FFFFFF"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_all"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnFilterEwaste"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_ewaste"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnFilterPaper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_paper"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnFilterFabric"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_fabric"
            style="?android:attr/buttonBarButtonStyle" />

        <Button
            android:id="@+id/btnFilterGlass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_glass"
            style="?android:attr/buttonBarButtonStyle" />

    </LinearLayout>

</RelativeLayout>